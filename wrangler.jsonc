// https://developers.cloudflare.com/workers/wrangler/configuration/
{
  "name": "otterhub",
  "main": "functions/worker.ts",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./frontend/out",
    "binding": "ASSETS",
    "run_worker_first": [
      "/file/*",
      "/auth/*",
      "/settings/*",
      "/health",
      "/health/*",
      "/wallpaper/*",
      "/upload/*",
      "/trash/*",
      "/proxy/*",
      "/share/*",
      "/telegram/*"
    ]
  },
  "observability": {
    "enabled": true
  }
}
